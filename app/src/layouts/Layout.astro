---
import "styles/theme.css"
import ArianeLink from "components/ArianeLink.astro";
import HrefFixer from "components/HrefFixer.astro";
import MetaSocialPreview from "components/MetaSocialPreview.astro";
import ThemeIcon from 'components/ThemeIcon.astro';
import config from "../../legalstamp.config.json";
import { version as appVersion } from "../../package.json";

const title = "LegalStamp"
const descr = "LegalStamp"
const titlePlus = "⚖️ " + title

---
<!doctype html>
<html lang={Astro.currentLocale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="generator" content={Astro.generator} />
		<title>{titlePlus}</title>
		<MetaSocialPreview title={titlePlus} description={descr} />
		<HrefFixer />
	</head>
	<header>
		<nav>
			<h1>{titlePlus}</h1>
			<ThemeIcon />
		</nav>
	</header>
	<body>
		<ArianeLink />
		<slot />
	</body>
	<div id="spacer"/>
	<footer>
		{title} - v{appVersion} - {config.owner}
		{/*<LanguagePicker />*/}
	</footer>
</html>

<style>
	html,
	body {
		display: flex;
		flex-direction: column;
		margin: 0;
		height: 100%;
	}

	body {
		margin-left: .5rem;
	}

	nav {
		display: flex;
		flex-direction: row;
	}

	nav h1 {
		flex: 1;
	}

	#spacer {
		flex: 1;
	}

	footer {
		font-style: italic;
		font-size: .75rem;
		display: flex;
		padding: 1rem;
		justify-content: end;
	}
</style>
